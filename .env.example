# ========= 飞书应用配置 =========
# 飞书开放平台 → 应用管理 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书开放平台 → 事件订阅 → Verification Token
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书开放平台 → 事件订阅 → Encrypt Key（不启用加密可留空）
FEISHU_ENCRYPT_KEY=

# ========= OpenLDAP 配置 =========
# LDAP 服务地址（Docker 内网可用容器名）
LDAP_ADDR=ldap://go-ldap-admin-openldap:389

# LDAP 管理员 DN 和密码
LDAP_ADMIN_DN=cn=admin,dc=example,dc=com
LDAP_ADMIN_PASS=your_ldap_admin_password

# LDAP 搜索基准 DN
LDAP_BASE_DN=dc=example,dc=com

# ========= 服务端口（可选，默认 8080）=========
PORT=8080
